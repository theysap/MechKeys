#!/bin/bash
#
# Formatting, build and tests before each commit.
#
# Skip for a single commit with: git commit --no-verify

set -euo pipefail

cd "$(dirname "$0")/.."

GREEN=$'\033[0;32m'
RED=$'\033[0;31m'
RESET=$'\033[0m'
step() { echo "${GREEN}==>${RESET} $*"; }
fail() { echo "${RED}✗${RESET} $*" >&2; exit 1; }

step "Checking formatting"
swift format lint --recursive --strict Sources Tests \
    || fail "Formatting. Run: swift format --in-place --recursive Sources Tests"

step "Building"
swift build > /dev/null || fail "Build failed."

step "Testing"
./Scripts/test.sh > /dev/null 2>&1 || fail "Tests failed. Run ./Scripts/test.sh to see why."

# The samples are committed, so they must match what the generator produces.
# Only checked when the generator itself is part of the commit, since it needs
# numpy and most commits do not touch it.
if git diff --cached --name-only | grep -q "Tools/generate_sounds.py"; then
    step "Verifying the sound library matches the generator"
    before="$(shasum -a 256 Resources/Sounds/*/*.wav | sort)"
    python3 Tools/generate_sounds.py > /dev/null
    after="$(shasum -a 256 Resources/Sounds/*/*.wav | sort)"
    [ "${before}" = "${after}" ] \
        || fail "Samples changed. Commit the regenerated Resources/Sounds too."
fi
